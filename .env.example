# PLANTILLA. No pongas aqui valores reales: este fichero SI se sube a git.
#
# Copia este fichero a .env y rellena los valores ahi. El .env esta en
# .gitignore y nunca se sube.
#
#     copy .env.example .env

# Webhook de Discord: Ajustes del canal > Integraciones > Webhooks > Nuevo webhook
DISCORD_WEBHOOK_URL=

# Webhook del canal donde quieres los avisos de undercut, para no mezclarlos
# con los chollos. Si lo dejas vacio, los undercuts van al canal de arriba.
DISCORD_UNDERCUT_WEBHOOK_URL=

# Webhook del canal donde quieres los avisos de venta. Si lo dejas vacio, las
# ventas van al canal general.
DISCORD_VENTAS_WEBHOOK_URL=

# Credenciales de la API de Blizzard: https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# ----------------------------------------------------------------------------
#  Solo para la web publica (web/ y publicar_web.py)
# ----------------------------------------------------------------------------
#  El vigilante no las necesita: si solo usas main.py, dejalas en blanco.

# Que fichero es la base de la web. Lo leen las DOS mitades --la pasada que la
# llena y el servidor que la sirve-- y por eso tiene que estar aqui: sin ella
# cada una resuelve una ruta relativa contra su propio directorio de trabajo, y
# si no coinciden el servidor abre una base vacia y da 404 en todas las
# paginas. Pon una ruta absoluta.
AUCTION_DB=

# El dominio con el que se construyen las URLs del sitemap. Google no acepta
# URLs relativas ahi.
BASE_URL=
